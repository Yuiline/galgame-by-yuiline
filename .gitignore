# ===========================================
# .gitignore — 告诉 Git 不要上传这些文件
# ===========================================
# 【术语】以 # 开头的行是注释（给人看的说明，Git 不管）
#
# 什么时候需要改这个文件？
# - 你不想让别人看到某些文件时
# - 避免上传临时文件、依赖包等
# ===========================================

# 操作系统自动生成的临时文件
.DS_Store          # macOS 系统文件
Thumbs.db          # Windows 缩略图缓存
desktop.ini        # Windows 文件夹配置

# 编辑器自动生成的临时文件
.vscode/           # VSCode 配置（每个人习惯不同，不上传）
.idea/             # JetBrains IDE 配置
*.swp              # Vim 临时文件
*.swo

# 日志文件
*.log

# 环境变量（如果以后用 API 之类会用到）
.env

# 临时构建产物
node_modules/      # 如果以后用 npm
dist/              # 如果以后用打包工具
build/